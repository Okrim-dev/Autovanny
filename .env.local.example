# Copia in .env.local e compila con i valori del tuo progetto Supabase
# (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# La chiave pubblica/publishable (equivale all'anon key) per le letture client
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
# (Alternativa per retrocompatibilità)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Connection string del database — SOLO per npm run db:schema / db:seed / db:admin
# (Project Settings → Database → Connection pooling · Transaction)
# SUPABASE_DB_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Credenziali dell'amministratore iniziale (per npm run db:admin)
# ADMIN_EMAIL=admin@autovanny.com
# ADMIN_PASSWORD=CambiaQuestaPassword123

# Senza queste variabili il sito usa dati di esempio (mock) in modo trasparente.